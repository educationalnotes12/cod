<!DOCTYPE html>
<html>

<head>
    <title>Restaurant Website</title>

    <style>

        body{
            font-family: Arial;
            background-color: beige;
        }

        h1{
            text-align: center;
            color: darkred;
        }

        .menu{
            display: grid;
            grid-template-columns: auto auto;
            gap: 20px;
            padding: 20px;
        }

        .item{
            background-color: white;
            padding: 15px;
            text-align: center;
            border-radius: 10px;
        }

        img{
            width: 150px;
            height: 100px;
        }

    </style>

</head>

<body>

    <h1>Food Restaurant</h1>

    <div class="menu">

        <div class="item">

            <img src="https://via.placeholder.com/150">

            <h3>Pizza</h3>

            <p>Price: ₹250</p>

        </div>

        <div class="item">

            <img src="https://via.placeholder.com/150">

            <h3>Burger</h3>

            <p>Price: ₹120</p>

        </div>

        <div class="item">

            <img src="https://via.placeholder.com/150">

            <h3>Cold Drink</h3>

            <p>Price: ₹50</p>

        </div>

        <div class="item">

            <img src="https://via.placeholder.com/150">

            <h3>Pasta</h3>

            <p>Price: ₹180</p>

        </div>

    </div>

</body>

</html>
