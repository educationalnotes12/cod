<!DOCTYPE html>
<html>

<head>

    <title>Student Marks Calculator</title>

    <style>

        body{
            font-family: Arial;
            background: linear-gradient(to right, lightblue, lightgreen);
        }

        .box{
            width: 350px;
            background-color: white;
            padding: 20px;
            margin: auto;
            margin-top: 50px;
            border-radius: 10px;
            box-shadow: 2px 2px 10px gray;
        }

        button{
            background-color: blue;
            color: white;
            padding: 10px;
            border: none;
        }

        button:hover{
            background-color: darkblue;
        }

    </style>

</head>

<body>

<div class="box">

    <h2>Student Marks Calculator</h2>

    Name:
    <input type="text" id="name">

    <br><br>

    Subject 1:
    <input type="number" id="m1">

    <br><br>

    Subject 2:
    <input type="number" id="m2">

    <br><br>

    Subject 3:
    <input type="number" id="m3">

    <br><br>

    Subject 4:
    <input type="number" id="m4">

    <br><br>

    Subject 5:
    <input type="number" id="m5">

    <br><br>

    <button onclick="calculate()">
        Calculate
    </button>

    <h3 id="result"></h3>

</div>

<script>

function calculate(){

    var name =
    document.getElementById("name").value;

    var m1 =
    parseInt(document.getElementById("m1").value);

    var m2 =
    parseInt(document.getElementById("m2").value);

    var m3 =
    parseInt(document.getElementById("m3").value);

    var m4 =
    parseInt(document.getElementById("m4").value);

    var m5 =
    parseInt(document.getElementById("m5").value);

    var total = m1 + m2 + m3 + m4 + m5;

    var percentage = total / 5;

    var grade;

    if(percentage >= 75){

        grade = "A";

    }
    else if(percentage >= 60){

        grade = "B";

    }
    else{

        grade = "C";

    }

    document.getElementById("result").innerHTML =
    "Total = " + total +
    "<br>Percentage = " + percentage +
    "%<br>Grade = " + grade;

}

</script>

</body>

</html>
