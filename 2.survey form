<!DOCTYPE html>
<html>

<head>
    <title>Survey Form</title>

    <style>

        body{
            font-family: Arial;
            background-color: lightblue;
        }

        form{
            background-color: white;
            width: 300px;
            padding: 20px;
            margin: auto;
        }

    </style>

</head>

<body>

    <form>

        <h2>Survey Form</h2>

        Name:
        <input type="text">

        <br><br>

        Email:
        <input type="email">

        <br><br>

        Gender:
        <input type="radio" name="g"> Male
        <input type="radio" name="g"> Female

        <br><br>

        Hobbies:
        <input type="checkbox"> Cricket
        <input type="checkbox"> Coding
        <input type="checkbox"> Music

        <br><br>

        Course:

        <select>
            <option>Computer</option>
            <option>IT</option>
            <option>ENTC</option>
        </select>

        <br><br>

        <input type="submit" value="Submit">

    </form>

</body>

</html>
